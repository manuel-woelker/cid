    "test:run": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.132.24",
    "antd": "^5.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@typescript/native-preview": "^7.0.0-dev.20260327.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^27.0.1",
    "oxfmt": "^0.7.0",
    "oxlint": "^1.15.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^3.2.4"
  }
