recipe "default" {
  config live-display="line-per-task" max-parallel-tasks=8

  task "build" description="Build the cid workspace" {
    run shell="""
      cargo build \
        --workspace \
        --all-targets \
        --all-features
    """
  }

  task "fmt" description="Check code formatting" {
    run shell="""
      cargo fmt \
        --all \
        --check
    """
  }

  task "clippy" description="Run clippy across the workspace" {
    depends-on "build"
    run shell="""
      cargo clippy \
        --workspace \
        --all-targets \
        --all-features \
        -- \
        -D warnings
    """
  }

  task "test" description="Run the test suite" {
    depends-on "build"
    run shell="""
      cargo test \
        --workspace \
        --all-targets \
        --all-features
    """
  }

  task "ui-format" description="Format UI files with oxfmt" {
    run shell="""
      pnpm --dir ui format
      NAO_TASK_OUTCOME="UI files were formatted"
    """
  }

  task "ui-lint" description="Lint the UI with oxlint" {
    depends-on "ui-format"
    run shell="""
      pnpm --dir ui lint
      NAO_TASK_OUTCOME="UI lint passed"
    """
  }

  task "ui-typecheck" description="Typecheck the UI application source" {
    depends-on "ui-format"
    run shell="""
      pnpm --dir ui typecheck
      NAO_TASK_OUTCOME="UI typecheck passed"
    """
  }

  task "ui-test" description="Run the UI test suite" {
    depends-on "ui-format"
    run shell="""
      pnpm --dir ui test:run
      NAO_TASK_OUTCOME="UI tests passed"
    """
  }

  task "ui-build" description="Build the UI bundle" {
    depends-on "ui-format"
    run shell="""
      pnpm --dir ui build
      NAO_TASK_OUTCOME="UI production build succeeded"
    """
    artifact "ui-dist" path="ui/dist"
  }

  task "check" description="Run all repository verification tasks" {
    depends-on "fmt"
    depends-on "clippy"
    depends-on "test"
    depends-on "ui-format"
    depends-on "ui-lint"
    depends-on "ui-typecheck"
    depends-on "ui-test"
    depends-on "ui-build"
    run shell="""
      printf 'All repository verification tasks completed.\n'
    """
  }

  task "check-code" description="Run the full repository verification task graph" {
    depends-on "check"
    run script="./scripts/check-code.sh"
  }
}
